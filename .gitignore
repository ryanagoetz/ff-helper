.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Local runtime state (tokens, ranking cache, generated certs)
.ff-helper/
*.pem

# Projection and keeper CSVs. Exports from a paid subscription are not ours to
# redistribute, and this repo is public.
*.csv

# Everything in data/ is gitignored by default -- a league config carries a real league
# ID and your leaguemates' team names, and projection/keeper exports are not ours to
# redistribute. Only the generic example config and the anonymized draft dumps are
# allowed through. data/league-mock.yaml is generated by scripts/mock_config.py from a
# real mock room, so it stays local too.
data/*
!data/.gitkeep
!data/README.md
!data/league-example.yaml
!data/drafts/
data/drafts/*
!data/drafts/.gitkeep
!data/drafts/2025-shiva-snake.json

# Personal draft-day runbook -- names the real league and its teams throughout.
MOCK-DRAFT.md

# Generated reader scripts contain the bridge token.
*.ready.js
